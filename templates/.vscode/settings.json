{
  // ============================================================
  // GitHub Copilot — Settings (REPO-LEVEL, commit cho team)
  // ============================================================
  //
  // PHÂN TẦNG CẤU HÌNH — đọc kỹ trước khi sửa:
  //
  //   Personal (user settings)
  //     Vị trí: ~/Library/Application Support/Code/User/settings.json (macOS)
  //             ~/.config/Code/User/settings.json (Linux)
  //             %APPDATA%\Code\User\settings.json (Windows)
  //     Commit?: ❌ KHÔNG
  //     Dùng cho: ngôn ngữ trả lời, style riêng, instructions[].text, personal preferences
  //
  //   Repo (file này — .vscode/settings.json trong repo)
  //     Vị trí: .vscode/settings.json (TRONG REPO)
  //     Commit?: ✅ CÓ — toàn team dùng chung
  //     Dùng cho: quy tắc kỹ thuật, tool approval, exclude paths, terminal allow/deny...
  //
  //   Org policy (Business/Enterprise)
  //     Vị trí: github.com → Org Settings → Copilot → Policies
  //     Commit?: N/A — admin quản lý
  //
  // THỨ TỰ ƯU TIÊN khi xung đột (cao hơn ghi đè thấp hơn):
  //   org policy > repo settings (.vscode/settings.json) > user settings (máy cá nhân)
  //   Trong repo settings (tool approval): deny > ask > allow
  //
  // QUY TẮC VÀNG:
  //   - Personal preferences → user settings máy bạn (KHÔNG commit)
  //   - Quy tắc team → file trong repo + commit
  //   - Đừng trộn lẫn: nếu để personal trong repo, đồng nghiệp sẽ bị áp kiểu của bạn
  //
  // ============================================================

  // ---------- 1. INSTRUCTIONS ----------
  // BẮT BUỘC: tự động nạp .github/copilot-instructions.md + AGENTS.md + *.instructions.md
  // Vị trí settings này: .vscode/settings.json (repo-level, commit cho team)
  // Nếu muốn personal instructions → đặt trong ~/.config/Code/User/settings.json
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // Custom instructions dạng text (personal — KHÔNG commit, chỉ để user settings máy riêng)
  // "github.copilot.chat.codeGeneration.instructions": [
  //   { "text": "Trả lời bằng tiếng Việt, ngắn gọn. Code comments không dấu." }
  // ],

  // ---------- 2. CONTENT EXCLUSION ----------
  // Danh sách path bị loại khỏi context (Copilot KHÔNG đọc).
  // Ưu tiên cao nhất: chặn file nhạy cảm trước khi lọt vào model.
  "github.copilot.chat.exclude": [
    "**/*.pem",
    "**/*.key",
    "**/secrets/**",
    "**/.env*",
    "**/credentials*.json",
    "**/*.secret",
    "**/id_rsa*",
    "**/.npmrc",
    "**/.pypirc"
  ],

  // ---------- 3. ENABLE / DISABLE theo file type ----------
  // Bật/tắt Copilot Completions cho từng loại file.
  // plaintext/env=false → tắt gợi ý cho file text nhạy cảm và .env
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "env": false
  },

  // ---------- 3.5. FORMAT / LINT ON SAVE (từ 03-4-vs-code-extensions-pack-chuan-team.jsonc) ----------
  // Tự động format và fix lỗi khi lưu file — giúp codeチーム đồng nhất.
  // Tham khảo: 03-4-vs-code-extensions-pack-chuan-team.jsonc
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // ---------- 3.6. FILES / SEARCH EXCLUDE (tối ưu index workspace) ----------
  // Tham khảo: 01-3-bat-codebase-indexing-copy-paste.sh
  // node_modules, dist, .next, coverage… không cần Copilot đọc → index nhanh hơn, ít nhiễu.
  // Đây là setting VS Code chuẩn (không phải Copilot riêng), commit cho team.
  // "files.exclude": {
  //   "**/node_modules": true,
  //   "**/dist": true,
  //   "**/.next": true,
  //   "**/coverage": true
  // },
  // "search.exclude": {
  //   "**/node_modules": true,
  //   "**/dist": true,
  //   "**/.next": true,
  //   "**/coverage": true
  // },

  // ---------- 4. LANGUAGE GATING ----------
  // Chỉ bật gợi ý cho các ngôn ngữ team dùng → gợi ý chuẩn hơn, ít nhiễu.
  // Repo-level — đặt trong .vscode/settings.json (commit cho team).
  // Cá nhân muốn khác → thêm vào ~/.config/Code/User/settings.json
  "github.copilot.chat.language": {
    "enabled": ["typescript", "javascript", "python", "go", "java", "csharp", "rust", "php"],
    "disabled": []
  },

  // ---------- 5. TOOL APPROVAL ----------
  // Theo docs 11/2026 (code.visualstudio.com/docs/agents/run/approvals): approval KHÔNG phải
  // một key ba giá trị "allow/ask/deny" — mà là thang true/false + picker mức session:
  //   "allow" = true trong các rule autoApprove · "ask" = false hoặc chưa khớp rule nào
  //   "deny"  = chat.tools.eligibleForAutoApproval: false (chặn pre-approve) + sandbox + org policy
  // Repo-level → .vscode/settings.json (commit cho team); cá nhân → user settings.
  // (Key cũ "github.copilot.chat.toolAutoRun" / "github.copilot.chat.tools" không còn trong docs.)
  "chat.permissions.default": "manual",  // manual | assisted | allowAll — mức của session mới

  // ---------- 5.5. MCP TOOL & FETCH APPROVAL ----------
  // MCP tool chạy qua terminal/URL rules bên dưới; muốn tool KHÔNG BAO GIỜ được
  // pre-approve (popup luôn hiện, "Chat: Manage Tool Approval" không bật được) → section 5.2.
  // Theo server: "Chat: Manage Tool Approval" (UI) · org policy "MCP servers in Copilot" (bài 16).
  // Muốn agent chỉ THẤY một số tool → khai "tools" allowlist trong .mcp.json / mcp-config.json (bài 08).

  // ---------- 5.2. MCP TOOL: chặn auto-approve theo tool (deny cấp settings) ----------
  // Tên tool dạng mcp_<server>_<tool>; "Chat: Manage Tool Approval" liệt kê đủ.
  // "chat.tools.eligibleForAutoApproval": {
  //   "mcp_postgres-dev_query": false,      // DB dev: hỏi từng câu, không cho phép nhớ
  //   "mcp_playwright_browser_click": false // browser click có side effects
  // },

  // ---------- 5.1. TERMINAL COMMAND AUTO-APPROVE ----------
  // Quy tắc cho từng LỆNH TERMINAL cụ thể khi agent chạy shell (runInTerminal).
  // Đây là nơi team đặt allow/ask cho MCP stdio tool lẫn lệnh thường. Luồng kiểm tra:
  //   1. Khớp "true"  → chạy luôn, không hỏi (allow / auto-approve)
  //   2. Khớp "false" → bắt buộc hỏi (ask) — KHÔNG chặn hẳn; muốn chặn: section 5.2 + sandbox (mục 6)
  //   3. Không khớp   → mặc định hỏi
  //
  // Cách bật/tắt tính năng này toàn cục:
  //   "chat.tools.terminal.enableAutoApprove": true   // bật (mặc định true)
  //
  // Khóa (key) có thể là:
  //   - Tiền tố lệnh: "npm" sẽ khớp "npm install", "npm run test", ...
  //   - Regex: bao trong /.../, có thể có flags: /pattern/i
  //   - Chuỗi hoàn chỉnh: "git status"
  //
  // Giá trị: true = cho phép tự chạy | false = bắt buộc hỏi lại
  // Ưu tiên: false (deny) > true (allow). Các scope user/workspace được gộp.
  //
  // Các setting cũ (bị deprecated): github.copilot.chat.agent.terminal.allowList / denyList
  //   → hãy dùng "chat.tools.terminal.autoApprove" thay thế.

  // Bật tính năng auto-approve terminal (khuyến nghị khai báo rõ ràng)
  "chat.tools.terminal.enableAutoApprove": true,

  // Bỏ qua default auto-approve rules của VS Code (mặc định false = giữ default)
  // "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,

  // Tự động approve các npm script trong workspace (mặc định false)
  // "chat.tools.terminal.autoApproveWorkspaceNpmScripts": false,

  // Danh sách lệnh chi tiết (commit cho team)
  "chat.tools.terminal.autoApprove": {
    // --- DEV / BUILD: cho phép tự chạy (không hỏi) ---
    "npm": true,          // npm install, npm ci, npm run ... (tất cả)
    "npx": true,          // npx ... (tất cả)
    "node": true,         // node ... (chạy script/node)
    // "/^npm run (test|lint|build|dev|start)$/": true,  // ví dụ regex: chỉ các script whitelist
    // "pnpm": true,       // nếu team dùng pnpm
    // "yarn": true,       // nếu team dùng yarn
    // "cargo": true,      // nếu team dùng Rust
    // "pip": true,        // nếu team dùng Python pip
    // "mvn": true,        // nếu team dùng Java Maven
    // "gradle": true,     // nếu team dùng Gradle
    // "dotnet": true,     // nếu team dùng .NET

    // --- GIT: từ chối tự chạy (luôn hỏi lại) ---
    "git": false         // git commit/push/reset/... → luôn hỏi lại
  },

  // ---------- 6. GITHUB COPILOT - GIT INTEGRATION ----------
  // Tự động sinh commit message bằng Copilot (nếu extension hỗ trợ)
  // "git.commitMessageGeneration": "copilot",
  // "git.commitMessageUseCopilot": true,

  // ---------- 7. LOCALE / CHAT / INLINE CHAT ----------
  // Ngôn ngữ phản hồi Copilot (mặc định theo VS Code locale)
  // "github.copilot.chat.localeOverride": "en",

  // Vị trí hiển thị Chat panel (sidebar/panel/editor)
  // "chat.location": "sidebar",

  // Tùy chỉnh chat (theme, font, v.v. — thường để personal)
  // "chat.customization": {},

  // Inline Chat: hiển thị gợi ý khi chọn code
  // "inlineChat.enabled": true,

  // ---------- 8. MODEL SELECTION ----------
  // Model mặc định cho chat (tên exact từ picker — roster đổi theo quý).
  // Repo-level: "github.copilot.chat.model" + "completions.model"
  // Personal override: thêm vào ~/.config/Code/User/settings.json
  // Khuyến nghị: model rẻ cho default, task khó mới đổi tay sang model mạnh.
  // "github.copilot.chat.model": "gpt-mini-tier",

  // Model riêng cho inline completions (tiết kiệm credits — dùng model rẻ hơn).
  // "github.copilot.completions.model": "gpt-mini-tier",

  // Default model gợi ý cho team (commented — uncomment + đổi tên exact khi cần).
  // "github.copilot.chat.defaultModel": "<model rẻ trong roster 2026>"

  // ---------- 9. SANDBOX (Agent mode) ----------
  // Nhốt terminal agent vào giới hạn file + mạng.
  // Repo-level — đặt trong .vscode/settings.json (commit cho team).
  // Cá nhân muốn override → ~/.config/Code/User/settings.json
  // Hỗ trợ: macOS, Linux, WSL2.
  // Giá trị: "off" | "on"
  "chat.agent.sandbox.enabled": "off",

  // Chặn mạng khi sandbox bật
  "chat.agent.sandbox.network.allowNetwork": false,

  // Không cho chạy lệnh ngoài chuồng sandbox
  "chat.agent.sandbox.allowUnsandboxedCommands": false,

  // (Tùy chọn) Giới hạn đường dẫn sandbox có thể ghi/đọc — ví dụ:
  // "chat.agent.sandbox.fileSystem.mac": ["/Users/nguyenson/Github/tutorial/tutorial-github-copilot"],
  // "chat.agent.sandbox.fileSystem.linux": ["${workspaceFolder}"],

  // ---------- 10. ASSISTED PERMISSIONS + AUTO-ACCEPT ----------
  // Hiện Assisted mode trong permission picker (xem mức quyền trước khi bấm Allow).
  "chat.assistedPermissions.enabled": true,

  // Giây chờ auto-accept edit (0 = tắt — khuyến nghị 0 khi review kỹ).
  // >0 sẽ tự chấp nhận edit sau N giây nếu không tác động.
  "chat.editing.autoAcceptDelay": 0,

  // ---------- 11. TELEMETRY ----------
  // Mức thu thập telemetry client-side: "off" | "error" | "crash" | "all"
  // Personal override: thêm vào ~/.config/Code/User/settings.json
  // Lưu ý: tắt local KHÔNG nghĩa là hết log — org audit log (Business+) ghi server-side.
  // "telemetry.telemetryLevel": "all",
  // "github.copilot.telemetry": true

  // ---------- 12. MCP (Model Context Protocol) ----------
  // Đọc servers từ .vscode/mcp.json (cùng thư mục .vscode).
  // Secrets MCP chỉ qua ${input:...}/${env:...} trong mcp.json — KHÔNG hardcode token.
  "mcp.enabled": true
}
