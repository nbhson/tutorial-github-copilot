{
  "servers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${input:pg_url}"],
      "env": {}
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "GitHub PAT (fine-grained, chi repo can thiet). Tao o github.com/settings/tokens.",
      "password": true
    },
    {
      "type": "promptString",
      "id": "pg_url",
      "description": "Postgres URL READ-REPLICA + user readonly (VD: postgres://mcp_reader@replica.internal:5432/app). KHONG dung URL prod-write.",
      "password": true
    }
  ]
}
