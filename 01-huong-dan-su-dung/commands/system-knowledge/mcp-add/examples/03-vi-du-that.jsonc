// .vscode/mcp.json — thêm postgres-dev, trỏ read-replica, user chỉ có quyền đọc
{
  "servers": {
    "postgres-dev": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      // KHÔNG dán connection string thật ở đây:
      "env": { "DATABASE_URL": "${input:pg_readonly_url}" }
    }
  }
}
